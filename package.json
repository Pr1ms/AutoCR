{
  "name": "bun-react-template",
  "version": "0.1.0",
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "private": true,
  "scripts": {
    "dev": "bun --hot ./index.html",
    "build": "bun build ./index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bunx serve dist/ -l 8080"
  },
  "type": "module"
}
